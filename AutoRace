    if State.AntiAFK then
        AntiAfkBtn.Text = "Anti-AFK: ON"
        AntiAfkBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    else
        AntiAfkBtn.Text = "Anti-AFK: OFF"
