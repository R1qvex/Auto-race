    if State.AutoRace then
        stopAutoRace()
        ToggleBtn.Text = "▶ Start"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    else
        startAutoRace()
        ToggleBtn.Text = "⏹ Stop"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

